{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Commit standalone Map Studio",
			"type": "shell",
			"command": "C:\\Program Files\\Git\\cmd\\git.exe",
			"args": [
				"commit",
				"-m",
				"Launch standalone Map Studio app"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Add standalone GitHub remote",
			"type": "shell",
			"command": "C:\\Program Files\\Git\\cmd\\git.exe",
			"args": [
				"remote",
				"add",
				"standalone",
				"https://github.com/georgva0/BBC-Google-Maps-generator.git"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push standalone app to GitHub",
			"type": "shell",
			"command": "C:\\Program Files\\Git\\cmd\\git.exe",
			"args": [
				"push",
				"--set-upstream",
				"standalone",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}
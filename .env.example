# Server key. Used only inside the function for Static Maps and Geocoding.
# Never returned to the browser. Restrict it to those two APIs in Google Cloud.
GOOGLE_MAPS_API=replace-with-a-restricted-static-maps-api-key

# Browser key. Required for the interactive map; there is no fallback to the
# server key. Restrict it by HTTP referrer (your site's URL) and limit it to
# Maps JavaScript API + Places API.
GOOGLE_MAPS_API_CLIENT_KEY=replace-with-a-restricted-javascript-maps-api-key
